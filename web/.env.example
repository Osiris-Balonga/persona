NEXT_PUBLIC_PERSONA_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3001
PERSONA_API_UPSTREAM_URL=http://127.0.0.1:3000
# Same private value as api/.env; at least 32 characters. Never use NEXT_PUBLIC_ for this token.
PERSONA_API_PROXY_TOKEN=
# Vercel Preview upstream: https://persona-dev.onrender.com
# Vercel Production upstream: https://api-persona.osirisbalonga.me
# Set NEXT_PUBLIC_PERSONA_API_URL=https://persona.osirisbalonga.me/api for production.
# Without an explicit public URL, Next derives it from the Vercel deployment hostname.
# Set false only when targeting an older API without plural portraitContexts support.
NEXT_PUBLIC_PERSONA_PORTRAIT_CONTEXTS_ENABLED=true
ANALYTICS_API_URL=https://analytics.example.test
ANALYTICS_READ_TOKEN=
ANALYTICS_ENVIRONMENT=staging
