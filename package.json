{
  "name": "persona",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "data:refresh:countries": "node scripts/refresh-country-data.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e --passWithNoTests"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "iso-3166": "4.4.0",
    "libphonenumber-js": "1.13.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
